{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studyforge-web",
  "compatibility_date": "2024-12-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
  // Build: `vite build` (outputs ./dist), then `wrangler deploy`.
  // Set VITE_API_BASE at build time to the deployed API Worker URL.
}
